generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  apps     App[]
  aiConfig UserAiConfig?
}

enum Platform {
  PLAYSTORE
  APPSTORE
}

enum AppMode {
  AUTO
  MANUAL
}

model App {
  id                Int      @id @default(autoincrement())
  userId            Int
  name              String
  platform          Platform
  credentials       String   @db.Text  // AES-256-GCM encrypted JSON
  instructionPrompt String?  @db.Text
  mode              AppMode  @default(MANUAL)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews Review[]

  @@index([userId])
}

model Review {
  id           Int       @id @default(autoincrement())
  appId        Int
  reviewId     String    // provider's own review ID
  reviewerName String?
  rating       Int?
  content      String    @db.Text
  aiReply      String?   @db.Text
  isPublished  Boolean   @default(false)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, reviewId])
  @@index([appId])
}

enum AiProvider {
  GEMINI
  OPENAI
  CUSTOM
}

model UserAiConfig {
  id       Int        @id @default(autoincrement())
  userId   Int        @unique
  provider AiProvider @default(GEMINI)
  apiKey   String?    @db.Text  // AES-256-GCM encrypted, null = use server default
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}